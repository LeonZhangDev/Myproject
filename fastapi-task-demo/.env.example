POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_db

# FastAPI 在 WSL/Linux 中直接运行，PostgreSQL / Redis 在 Docker 中运行。
DATABASE_URL=postgresql+asyncpg://task_user:task_password@127.0.0.1:5432/task_db
REDIS_URL=redis://127.0.0.1:6379/0

# 学习阶段设为 true，可以在终端观察 SQLAlchemy 发出的 SQL。
SQL_ECHO=true

# Redis Cache-Aside TTL。
TASK_CACHE_TTL_SECONDS=300
TASK_NULL_CACHE_TTL_SECONDS=60

# /tasks 固定窗口限流：每个客户端 60 秒最多 60 次。
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
